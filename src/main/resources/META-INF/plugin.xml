<idea-plugin>
    <id>com.github.tropin.rider-mcp</id>
    <name>MCP Server Extension</name>
    <vendor url="https://github.com/tropin">tropin</vendor>

    <description><![CDATA[
        Extends the JetBrains MCP Server with IDE observability and control for Rider.
        Build management, test runner, process control, IDE state monitoring, editor context.
    ]]></description>

    <depends>com.intellij.modules.rider</depends>
    <depends>com.intellij.mcpServer</depends>
    <depends optional="true" config-file="db-consoles.xml">com.intellij.database</depends>

    <dependencies>
        <plugin id="intellij.testRunner.plugin" />
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <mcpServer.mcpToolset implementation="com.github.tropin.ridermcp.build.BuildToolset"/>
        <mcpServer.mcpToolset implementation="com.github.tropin.ridermcp.process.ProcessToolset"/>
        <mcpServer.mcpToolset implementation="com.github.tropin.ridermcp.ide.IdeStateToolset"/>
        <mcpServer.mcpToolset implementation="com.github.tropin.ridermcp.ide.TerminalToolset"/>
        <mcpServer.mcpToolset implementation="com.github.tropin.ridermcp.context.ContextToolset"/>
        <mcpServer.mcpToolset implementation="com.github.tropin.ridermcp.testing.TestToolset"/>
        <mcpServer.mcpToolset implementation="com.github.tropin.ridermcp.debugger.DebugToolset"/>
        <mcpServer.mcpToolset implementation="com.github.tropin.ridermcp.nuget.NuGetToolset"/>
        <mcpServer.mcpToolset implementation="com.github.tropin.ridermcp.runconfig.RunConfigToolset"/>
        <mcpServer.mcpToolset implementation="com.github.tropin.ridermcp.settings.SettingsToolset"/>
        <mcpServer.mcpToolset implementation="com.github.tropin.ridermcp.admin.AdminToolset"/>
        <mcpServer.mcpToolset implementation="com.github.tropin.ridermcp.profiling.ProfilingToolset"/>
        <mcpServer.mcpToolset implementation="com.github.tropin.ridermcp.profiling.MemoryToolset"/>
    </extensions>
</idea-plugin>
