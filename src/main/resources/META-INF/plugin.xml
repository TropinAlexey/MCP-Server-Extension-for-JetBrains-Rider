<idea-plugin>
    <id>com.github.tropin.rider-mcp</id>
    <name>MCP Server Extension</name>
    <vendor url="https://github.com/tropin">tropin</vendor>

    <description><![CDATA[
        Extends the JetBrains MCP Server plugin with IDE observability and control for Rider.
        Build management, test runner, process control, IDE state monitoring, editor context.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.mcpServer</depends>

    <extensions defaultExtensionNs="com.intellij.mcpServer">
        <!-- Build -->
        <mcpTool implementation="com.github.tropin.ridermcp.build.StartBuildTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.build.GetOutputTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.build.CancelBuildTool"/>

        <!-- Process management -->
        <mcpTool implementation="com.github.tropin.ridermcp.process.ListProcessesTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.process.KillProcessTool"/>

        <!-- IDE state -->
        <mcpTool implementation="com.github.tropin.ridermcp.ide.GetIdeStateTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.ide.GetNotificationsTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.ide.ListToolWindowsTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.ide.GetToolWindowContentTool"/>

        <!-- Test runner -->
        <mcpTool implementation="com.github.tropin.ridermcp.testing.RunTestsTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.testing.GetTestResultsTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.testing.RerunFailedTestsTool"/>

        <!-- Run config CRUD -->
        <mcpTool implementation="com.github.tropin.ridermcp.runconfig.CreateRunConfigTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.runconfig.UpdateRunConfigTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.runconfig.DeleteRunConfigTool"/>

        <!-- Debugger -->
        <mcpTool implementation="com.github.tropin.ridermcp.debugger.SetBreakpointTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.debugger.RemoveBreakpointTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.debugger.StartDebugTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.debugger.DebugStateTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.debugger.DebugEvaluateTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.debugger.DebugStepTool"/>

        <!-- NuGet -->
        <mcpTool implementation="com.github.tropin.ridermcp.nuget.ListPackagesTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.nuget.ManagePackageTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.nuget.NuGetRestoreTool"/>

        <!-- Inspections -->
        <mcpTool implementation="com.github.tropin.ridermcp.settings.ListInspectionsTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.settings.ToggleInspectionTool"/>

        <!-- Programmer context -->
        <mcpTool implementation="com.github.tropin.ridermcp.context.GetContextTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.context.GetRecentFilesTool"/>
    </extensions>
</idea-plugin>
